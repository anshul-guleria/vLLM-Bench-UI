# Where vLLM is serving its OpenAI-compatible API (keep the /v1).
VLLM_BASE_URL=http://localhost:8000/v1

# The model id exactly as vLLM reports it (see GET /v1/models).
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional. Leave blank for a local server started without --api-key.
VLLM_API_KEY=

# The probe UI itself.
FLASK_HOST=127.0.0.1
FLASK_PORT=5050

# Per-request timeout in seconds. Raise it for long generations.
REQUEST_TIMEOUT=120
